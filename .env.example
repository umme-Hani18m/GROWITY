# Public Supabase settings. Only these two NEXT_PUBLIC variables are read by browser code.
# NEXT_PUBLIC_SUPABASE_URL is the project origin; the client only repairs known Supabase REST/Auth suffixes.
NEXT_PUBLIC_SUPABASE_URL=https://example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=FAKE_PUBLIC_PUBLISHABLE_OR_ANON_KEY_DO_NOT_USE

# Provider site key (shown to browsers as required by CAPTCHA; not a secret).
TURNSTILE_SITE_KEY=FAKE_TURNSTILE_SITE_KEY_DO_NOT_USE

# Server-only secrets. Never expose or log these values.
SUPABASE_SERVICE_ROLE_KEY=FAKE_SERVER_ONLY_SECRET_OR_SERVICE_ROLE_KEY_DO_NOT_USE
TURNSTILE_SECRET_KEY=FAKE_SERVER_ONLY_TURNSTILE_SECRET_DO_NOT_USE
CHILD_PIN_PEPPER=FAKE_SERVER_ONLY_CHILD_PIN_PEPPER_REPLACE_WITH_RANDOM_32_BYTES
RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
RESEND_API_KEY=FAKE_SERVER_ONLY_EMAIL_PROVIDER_KEY_DO_NOT_USE

# Non-secret runtime settings (the sender must be verified with the email provider).
APP_URL=http://localhost:3000
SMS_OTP_ENABLED=false
ON_CALL_PROTECTION_EMAIL=on-call@example.invalid
FROM_EMAIL=notifications@example.invalid
